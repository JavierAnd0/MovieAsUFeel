TMDB_API_KEY=your_tmdb_api_key_here

# Language model for the free-text field ("terror analógico", "algo como Hereditary").
# Gemini is tried first, then OpenRouter; with neither, a rule-based analyzer is used.
# Gemini key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: comma-separated model lists, tried in order. Free models get retired
# often; set these to replace the built-in lists without a deploy.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free
